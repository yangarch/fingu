# intervals.icu — activity source since 2026-09-30 (Garmin → intervals.icu → fingu).
# Personal API key: intervals.icu → Settings → Developer Settings.
INTERVALS_API_KEY=
# Optional: first local date to analyze (earlier swims were handled via Strava).
INTERVALS_SINCE=2026-09-30
# Optional: poll interval in minutes (intervals.icu webhooks are OAuth-app only).
INTERVALS_POLL_MINUTES=15
# Optional: DB athlete id that owns the analyses (dashboard). Defaults to the only one in the DB.
INTERVALS_OWNER_ATHLETE_ID=

# Strava (optional, disabled) — API became subscriber-only on 2026-09-30.
# Set all three only if the Strava subscription is restored.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Server
BASE_URL=https://your-server-url.com
PORT=3003

# Database
DATABASE_URL=/app/data/swim-analyzer.db

# Notifications (optional) — Discord or Slack incoming webhook. Receives each
# finished analysis and failure alerts. Leave unset to disable.
NOTIFICATION_WEBHOOK_URL=

# Admin — token guarding POST /admin/backfill and GET /login?token=… (dashboard login).
# Falls back to STRAVA_VERIFY_TOKEN when unset; empty disables both.
ADMIN_TOKEN=
